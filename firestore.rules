rules_version = '2';
// Firebase コンソールの Firestore → ルール に、この内容を貼って「公開」する。
// 招待コード（24文字）を知っている、ログイン済み（匿名ログイン）の端末だけが読み書きできる。
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow get, create, update: if request.auth != null && roomId.size() >= 20;
      allow list, delete: if false;

      match /memories/{memoryId} {
        allow read, write: if request.auth != null;
      }
      match /photos/{photoId} {
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null && request.resource.data.data.size() < 1000000;
      }
    }
  }
}
